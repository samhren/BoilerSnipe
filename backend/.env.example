# Database
DATABASE_URL=sqlite:///./purdue_courses.db
# For PostgreSQL, use: postgresql://user:password@localhost/dbname

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Telegram Notifications (FREE!)
# 1. Message @BotFather on Telegram to create a bot
# 2. Copy your bot token here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Proxy (Optional - for rotating IPs)
# PROXY_URL=http://username:password@proxy-server:port

# Scraper Settings
INVENTORY_CRON=0 2 * * *          # Daily at 2 AM - scrapes all course IDs
SNIPER_INTERVAL_MINUTES=3          # Every 3 minutes - checks seats for tracked courses only
