# Database
DATABASE_URL=sqlite:///./purdue_courses.db
# For PostgreSQL, use: postgresql://user:password@localhost/dbname

# JWT Authentication
# REQUIRED - the app refuses to start without it, there is no fallback default.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth
# The Client ID from Google Cloud Console -> Google Auth Platform -> Clients.
# Must be the same value as VITE_GOOGLE_CLIENT_ID in frontend/.env: it is the
# expected audience when validating ID tokens, so a mismatch rejects every login.
# If unset, /api/auth/google fails closed and returns 401.
# The OAuth client *secret* is not used by this app. Do not add it.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Email Notifications (Resend)
# 1. Sign up at https://resend.com and create an API key
# 2. Paste it here. The sender address is set in workers/notifier.py.
RESEND_API_KEY=your_resend_api_key

# Proxy (Optional - for rotating IPs while scraping)
# PROXY_URL=http://username:password@proxy-server:port

# Scraper Settings
INVENTORY_CRON=0 2 * * 0           # Weekly on Sunday at 2 AM - scrapes all course IDs
SNIPER_INTERVAL_MINUTES=5          # Every 5 minutes - checks seats for tracked courses only
RUN_STARTUP_INVENTORY_ONCE=true    # Run one inventory scrape on startup
ENABLE_RECURRING_INVENTORY=false   # Enable the INVENTORY_CRON schedule

# Term Settings
CURRENT_TERM_CODE=202710
CURRENT_TERM_NAME=Fall 2026
# Comma-separated subjects to scrape; leave unset to use the built-in full list
# INVENTORY_SUBJECTS=CS,MA,STAT

# CORS / Security
# FRONTEND_URL=https://your-frontend-domain.com
ALLOWED_HOSTS=*                    # Use "*" when behind a reverse proxy
